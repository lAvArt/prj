#!/usr/bin/env bash
# prj — pick one of your projects from a list and open it in your AI agent, editor or shell.
#
# First run `prj --setup`: it finds the folders that hold your git repos, asks what to run
# and what you want to type, and wires up your shell. After that:
#
#   prj                 fuzzy picker (pinned, then most used, then latest commit)
#   prj <query>         open the best match directly (picker if ambiguous)
#   prj -p [query]      print the project path (your cd command uses this)
#   prj -l [--tsv]      list projects
#   prj -o <mode>       open with: auto | herdr-tab | tmux-window | here
#   prj -r <command>    run this instead of the configured command
#   prj <q> -- <args>   pass extra args to the run command (e.g. -- --continue)
#   prj --setup         (re)run the setup wizard
#   prj --doctor        check dependencies, folders and shell integration
#   prj --edit          open the config file
#   prj --uninstall     remove the shell hooks, shell files and Claude skill that setup added
#
# Needs bash, git and fzf. Uses gum, jq, herdr and tmux when present.

PRJ_VERSION=0.1.1

CONFIG="${PRJ_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/prj/config}"
CONFIG_DIR="$(dirname "$CONFIG")"
STATE_DIR="${PRJ_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/prj}"
HISTORY="$STATE_DIR/history"
TAB="$(printf '\t')"

# Settings (overwritten by the config file)
ROOTS=() PINNED=() EXCLUDE=() DEPTH=1 RUN="" OPEN=auto NAME=prj CD_NAME=pcd

die() { printf 'prj: %s\n' "$*" >&2; exit 1; }
warn() { printf 'prj: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
has_tty() { (: </dev/tty) 2>/dev/null; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }
tilde() { case "$1" in "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;; *) printf '%s' "$1" ;; esac; }
expand() { case "$1" in "~") printf '%s' "$HOME" ;; "~/"*) printf '%s/%s' "$HOME" "${1#"~/"}" ;; *) printf '%s' "$1" ;; esac; }
join() { local IFS=,; printf '%s' "$*" | sed 's/,/, /g'; }

# split_list <array-name> <comma separated values>
split_list() {
  local IFS=, item parts out=()
  read -ra parts <<<"$2"
  for item in "${parts[@]}"; do
    item="$(trim "$item")"
    [ -n "$item" ] && out+=("$item")
  done
  eval "$1=(\"\${out[@]}\")"
}

load_config() {
  [ -f "$CONFIG" ] || return 1
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    case "$line" in *=*) ;; *) continue ;; esac
    key="$(trim "${line%%=*}")" val="$(trim "${line#*=}")"
    case "$key" in
      roots) split_list ROOTS "$val" ;;
      pinned) split_list PINNED "$val" ;;
      exclude) split_list EXCLUDE "$val" ;;
      depth) DEPTH="$val" ;;
      run) RUN="$val" ;;
      open) OPEN="$val" ;;
      name) NAME="$val" ;;
      cd_name) CD_NAME="$val" ;;
    esac
  done <"$CONFIG"
  case "$DEPTH" in [1-5]) ;; *) DEPTH=1 ;; esac
}

# ---------------------------------------------------------------- discovery

# Print the path of every repo under the configured roots, skipping repos nested in other repos.
discover() {
  local root
  for root in "${ROOTS[@]}"; do
    root="$(expand "$root")" root="${root%/}"
    [ -d "$root" ] || continue
    find "$root" -mindepth 2 -maxdepth $((DEPTH + 1)) \
      \( -name node_modules -o -name vendor -o -name .venv -o -name .cache \) -prune \
      -o -name .git -prune -print 2>/dev/null
  done | sed 's#/\.git$##' | sort -u |
    awk '{ for (i = 1; i <= n; i++) if (index($0, kept[i] "/") == 1) next; kept[++n] = $0; print }' |
    while IFS= read -r dir; do excluded "$dir" || printf '%s\n' "$dir"; done
}

excluded() {
  local pat
  for pat in "${EXCLUDE[@]}"; do
    # shellcheck disable=SC2053
    [[ $1 == */$pat ]] && return 0
  done
  return 1
}

# repo_meta <dir> -> "<date>\t<branch>"
repo_meta() {
  local d="$1" date branch
  if git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then
    date="$(git -C "$d" log -1 --format=%cs 2>/dev/null)"
    branch="$(git -C "$d" branch --show-current 2>/dev/null)"
    printf '%s\t%s\n' "${date:--}" "${branch:-(detached)}"
  elif grep -qE '^gitdir: [A-Za-z]:' "$d/.git" 2>/dev/null; then
    printf -- '-\t(windows worktree)\n'   # created on Windows; its gitdir is a drive-letter path
  else
    printf -- '-\t(unreachable)\n'
  fi
}

# Ranked rows: pin \t score \t date \t name \t branch \t path
list_rows() {
  local dir name pin i p lname
  discover | while IFS= read -r dir; do
    name="${dir##*/}" lname="$(lower "$name")" pin=999 i=0
    for p in "${PINNED[@]}"; do
      i=$((i + 1))
      [ "$(lower "$p")" = "$lname" ] && pin=$i && break
    done
    printf '%s\t%s\t%s\t%s\n' "$pin" "$name" "$(repo_meta "$dir")" "$dir"
  done | awk -F'\t' -v OFS='\t' -v now="$(date +%s)" -v hist="$HISTORY" '
    BEGIN { while ((getline l < hist) > 0) { split(l, a, "\t"); age = (now - a[1]) / 86400; if (age < 0) age = 0; s[a[2]] += 1 / (1 + age) } }
    { print $1, sprintf("%.4f", ($5 in s) ? s[$5] : 0), $3, $2, $4, $5 }' |
    sort -t"$TAB" -k1,1n -k2,2gr -k3,3r -k4,4
}

# Turn ranked rows into "display \t path" lines
format_rows() {
  awk -F'\t' '
    { row[NR] = $0; if (length($4) > w) w = length($4)
      b = (length($5) > 34) ? substr($5, 1, 33) "~" : $5; br[NR] = b; if (length(b) > bw) bw = length(b) }
    END { fmt = "%s %-" w "s  %-" bw "s  %-10s\t%s\n"
      for (i = 1; i <= NR; i++) { split(row[i], f, "\t"); printf fmt, (f[1] < 999) ? "*" : " ", f[4], br[i], f[3], f[6] } }'
}

no_projects() {
  local root missing=""
  for root in "${ROOTS[@]}"; do [ -d "$(expand "$root")" ] || missing="$missing $root"; done
  [ -n "$missing" ] && die "project folder(s) not found:$missing (unmounted drive? fix with prj --setup)"
  die "no git repos found under: $(join "${ROOTS[@]}")"
}

# Preview on the right, hidden on narrow terminals. fzf before 0.31 rejects the size threshold
# (and the whole picker with it), so fall back to the older syntax there.
preview_layout() {
  if printf 'x\n' | fzf --filter x --preview-window='right,50%,<50(hidden)' >/dev/null 2>&1; then
    printf '%s' 'right,50%,<50(hidden)'
  else
    printf '%s' 'right:50%'
  fi
}

# pick [query] -> prints the chosen path
pick() {
  local query="$1" rows matches n
  rows="$(list_rows)"
  [ -n "$rows" ] || no_projects
  if [ -n "$query" ]; then
    matches="$(printf '%s\n' "$rows" | awk -F'\t' -v q="$(lower "$query")" 'tolower($4) == q')"
    [ -n "$matches" ] || matches="$(printf '%s\n' "$rows" | awk -F'\t' -v OFS='\t' '{ print $4, $0 }' |
      fzf --filter="$query" --delimiter="$TAB" --nth=1 | cut -f2-)"
    n="$(printf '%s' "$matches" | grep -c .)"
    if [ "$n" -eq 1 ]; then printf '%s\n' "$matches" | cut -f6; return 0; fi
    if ! has_tty; then
      [ "$n" -eq 0 ] && die "no project matches '$query' (see: prj -l)"
      warn "'$query' matches several projects:"
      printf '%s\n' "$matches" | cut -f4 | sed 's/^/  /' >&2
      return 1
    fi
  elif ! has_tty; then
    die "the picker needs a terminal; pass a project name (see: prj -l)"
  fi
  printf '%s\n' "$rows" | format_rows |
    fzf --query="$query" --delimiter="$TAB" --with-nth=1 --height=60% --reverse \
      --prompt="$NAME> " --header='enter: open   esc: cancel   * pinned' \
      --preview='git -C {2} log --oneline -8 --color=always 2>/dev/null; echo; git -C {2} status -sb 2>/dev/null | head -15' \
      --preview-window="$(preview_layout)" | cut -f2
}

record() {
  mkdir -p "$STATE_DIR" && printf '%s\t%s\n' "$(date +%s)" "$1" >>"$HISTORY"
  if [ $(($(wc -l <"$HISTORY"))) -gt 2000 ]; then
    tail -n 1000 "$HISTORY" >"$HISTORY.tmp" && mv "$HISTORY.tmp" "$HISTORY"
  fi
}

# ---------------------------------------------------------------- opening

# True when this terminal is a tmux pane. With tmux and herdr nested in either order, both
# set their variables, so compare ttys to find which one we are actually running in.
in_tmux_pane() {
  [ -n "${TMUX:-}" ] && have tmux || return 1
  [ "$(tmux display-message -p -t "${TMUX_PANE:-}" '#{pane_tty}' 2>/dev/null)" = "$(tty 2>/dev/null)" ]
}

open_project() {
  local dir="$1" name="${1##*/}" mode="$OPEN" cmd="$RUN" a pane json
  for a in "${AGENT_ARGS[@]}"; do cmd="$cmd $(printf '%q' "$a")"; done
  record "$dir"

  if [ "$mode" = auto ]; then
    if in_tmux_pane; then mode=tmux-window
    elif [ "${HERDR_ENV:-}" = 1 ] && have herdr; then mode=herdr-tab
    else mode=here; fi
  fi
  if [ "$mode" = herdr-tab ] && { [ "${HERDR_ENV:-}" != 1 ] || ! have herdr; }; then
    warn "not inside herdr, opening here"; mode=here
  fi
  if [ "$mode" = tmux-window ] && [ -z "${TMUX:-}" ]; then
    warn "not inside tmux, opening here"; mode=here
  fi

  case "$mode" in
    herdr-tab)
      json="$(herdr tab create --cwd "$dir" --label "$name" --focus)" || die "herdr could not create a tab"
      if have jq; then pane="$(printf '%s' "$json" | jq -r '.result.root_pane.pane_id')"
      else pane="$(printf '%s' "$json" | grep -o '"root_pane":{[^}]*"pane_id":"[^"]*"' | grep -o '[^"]*"$' | tr -d '"')"; fi
      [ -n "$cmd" ] && herdr pane run "$pane" "$cmd" >/dev/null
      ;;
    tmux-window)
      pane="$(tmux new-window -c "$dir" -n "$name" -P -F '#{pane_id}')" || die "tmux could not open a window"
      [ -n "$cmd" ] && tmux send-keys -t "$pane" -l "$cmd" && tmux send-keys -t "$pane" Enter
      ;;
    here)
      cd "$dir" || die "cannot enter $dir"
      if [ -z "$cmd" ]; then
        warn "new shell in $(tilde "$dir"), exit to return"
        exec "${SHELL:-bash}" -i
      elif have "${cmd%% *}"; then
        eval "exec $cmd"
      else
        exec "${SHELL:-bash}" -ic "$cmd"   # aliases and shell functions (e.g. Omarchy's cx, hdl)
      fi
      ;;
    *) die "unknown open mode '$mode' (use auto, herdr-tab, tmux-window or here)" ;;
  esac
}

# ---------------------------------------------------------------- setup

count_repos() {
  local n=0 d
  for d in "$1"/*/; do [ -e "${d}.git" ] && n=$((n + 1)); done
  printf '%s' "$n"
}

# Folders that look like they hold projects: "<count>\t<path>", most repos first
candidate_roots() {
  local c m
  {
    for c in code src projects Projects dev Dev Developer development Development work Work \
      git repos workspace Documents/GitHub Documents/Projects source/repos; do
      printf '%s\n' "$HOME/$c"
    done
    printf '%s\n' "$HOME"
    for base in ${PRJ_SCAN_MOUNTS-/run/media/$USER /media/$USER /mnt /Volumes}; do
      for m in "$base"/*; do
      [ -d "$m" ] || continue
      printf '%s\n' "$m"
      for c in "$m"/*/; do printf '%s\n' "${c%/}"; done
      done
    done
  } | while IFS= read -r c; do
    [ -d "$c" ] || continue
    real="$(cd "$c" 2>/dev/null && pwd -P)" || continue   # only to spot the same folder reached twice
    n="$(count_repos "$c")"
    [ "$n" -gt 0 ] && printf '%s\t%s\t%s\n' "$n" "$c" "$real"
  done | sort -t"$TAB" -k3,3 -u | sort -t"$TAB" -k1,1nr | cut -f1,2
}

use_gum() { have gum && has_tty; }

# ask_choose <prompt> <options...>  (first option is the default)
ask_choose() {
  local prompt="$1" i=0 o choice; shift
  if use_gum; then gum choose --header "$prompt" "$@" </dev/tty; return; fi
  printf '%s\n' "$prompt" >/dev/tty
  for o in "$@"; do i=$((i + 1)); printf '  %d) %s\n' "$i" "$o" >/dev/tty; done
  printf 'Choice [1]: ' >/dev/tty; read -r choice </dev/tty
  case "$choice" in '' | *[!0-9]*) choice=1 ;; esac
  i=0; for o in "$@"; do i=$((i + 1)); [ "$i" -eq "$choice" ] && printf '%s\n' "$o" && return; done
  printf '%s\n' "$1"
}

# ask_multi <prompt> <preselected (comma list)> <options...>
ask_multi() {
  local prompt="$1" selected="$2" i=0 o picks; shift 2
  if use_gum; then gum choose --no-limit --header "$prompt" --selected "$selected" "$@" </dev/tty; return; fi
  printf '%s\n' "$prompt" >/dev/tty
  for o in "$@"; do i=$((i + 1)); printf '  %d) %s\n' "$i" "$o" >/dev/tty; done
  printf 'Numbers separated by spaces [all]: ' >/dev/tty; read -r picks </dev/tty
  i=0; for o in "$@"; do
    i=$((i + 1))
    if [ -z "$picks" ] || [[ " $picks " == *" $i "* ]]; then printf '%s\n' "$o"; fi
  done
}

ask_input() {   # ask_input <prompt> <default>
  local reply
  if use_gum; then gum input --header "$1" --value "$2" </dev/tty; return; fi
  printf '%s [%s]: ' "$1" "$2" >/dev/tty; read -r reply </dev/tty
  printf '%s\n' "${reply:-$2}"
}

ask_yn() {   # ask_yn <prompt>  (default yes)
  local reply
  if use_gum; then gum confirm "$1" </dev/tty; return; fi
  printf '%s [Y/n]: ' "$1" >/dev/tty; read -r reply </dev/tty
  case "$reply" in [nN]*) return 1 ;; esac
}

valid_name() { [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]]; }

# What already answers to <name> in the user's shell, unless it is ours
name_taken() {
  local out
  out="$("${SHELL:-bash}" -ic "type $1" 2>/dev/null </dev/null)" || return 1
  case "$out" in *"command prj"* | *"prj -p"*) return 1 ;; esac
  printf '%s\n' "$out" | head -1
}

run_options() {
  local a first=""
  for a in claude codex opencode gemini crush cursor-agent aider copilot; do
    have "$a" || continue
    printf '%s\n' "$a"; [ -z "$first" ] && first="$a"
  done
  [ -n "${OMARCHY_PATH:-}" ] && have herdr && [ -n "$first" ] && printf 'hdl %s\n' "$first"
  [ -n "${EDITOR:-}" ] && printf '%s .\n' "${EDITOR##*/}"
  printf '(nothing, just a shell)\n'
}

write_config() {
  mkdir -p "$CONFIG_DIR"
  local roots=() r
  for r in "${ROOTS[@]}"; do roots+=("$(tilde "$r")"); done
  cat >"$CONFIG" <<EOF
# prj config. Edit freely, or re-run: prj --setup

# Folders that hold your projects (comma separated) and how deep to look for repos in them
roots = $(join "${roots[@]}")
depth = $DEPTH

# Command typed in the project when it opens: an agent, an editor, a layout, or empty
run = $RUN

# Where to open it: auto (herdr tab, else tmux window, else this terminal) | herdr-tab | tmux-window | here
open = $OPEN

# Projects always listed first, and name/path patterns to hide (comma separated)
pinned = $(join "${PINNED[@]}")
exclude = $(join "${EXCLUDE[@]}")

# Shell commands set up for you: one opens a project, one just cd's into it
name = $NAME
cd_name = $CD_NAME
EOF
}

RC_COMMENT='# prj: project picker (added by prj --setup)'
SKILL_MARKER='<!-- generated by prj --setup -->'

# The line added to ~/.bashrc and ~/.zshrc
rc_hook() {
  local sh="$CONFIG_DIR/shell.sh" hook
  hook="[ -f \"$(tilde "$sh")\" ] && . \"$(tilde "$sh")\""
  printf '%s\n' "${hook//\~/\$HOME}"
}

write_shell_integration() {
  local sh="$CONFIG_DIR/shell.sh" names="prj" rc hook
  [ "$NAME" != prj ] && names="$names $NAME"
  [ -n "$CD_NAME" ] && names="$names $CD_NAME"
  {
    printf '# Generated by `prj --setup`. Re-run it to change these names.\n'
    [ "$NAME" != prj ] && printf '%s() { command prj "$@"; }\n' "$NAME"
    [ -n "$CD_NAME" ] && printf '%s() { local d; d="$(command prj -p "$@")" && cd "$d"; }\n' "$CD_NAME"
    cat <<EOF
if [ -n "\$BASH_VERSION" ]; then
  _prj_complete() { local IFS=\$'\\n'; COMPREPLY=(\$(compgen -W "\$(command prj --names 2>/dev/null)" -- "\${COMP_WORDS[COMP_CWORD]}")); }
  complete -F _prj_complete $names
elif [ -n "\$ZSH_VERSION" ]; then
  _prj_complete() { compadd -- \${(f)"\$(command prj --names 2>/dev/null)"}; }
  (( \$+functions[compdef] )) && compdef _prj_complete $names
fi
EOF
  } >"$sh"

  hook="$(rc_hook)"
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    case "$rc" in
      *bashrc) [ -f "$rc" ] || [ "${SHELL##*/}" = bash ] || continue ;;
      *zshrc) [ -f "$rc" ] || [ "${SHELL##*/}" = zsh ] || continue ;;
    esac
    grep -qxF "$hook" "$rc" 2>/dev/null || printf '\n%s\n%s\n' "$RC_COMMENT" "$hook" >>"$rc"
  done

  if have fish || [ -d "$HOME/.config/fish" ]; then
    mkdir -p "$HOME/.config/fish/conf.d"
    {
      printf '# Generated by `prj --setup`.\n'
      [ "$NAME" != prj ] && printf 'function %s; command prj $argv; end\n' "$NAME"
      [ -n "$CD_NAME" ] && printf 'function %s; set -l d (command prj -p $argv); and cd $d; end\n' "$CD_NAME"
      for n in $names; do printf "complete -c %s -f -a '(command prj --names 2>/dev/null)'\n" "$n"; done
    } >"$HOME/.config/fish/conf.d/prj.fish"
  fi
}

write_claude_skill() {
  local dir="$HOME/.claude/skills/repo" examples
  examples="$(list_rows | cut -f4 | head -8 | paste -sd, - | sed 's/,/, /g')"
  mkdir -p "$dir"
  cat >"$dir/SKILL.md" <<EOF
---
name: repo
description: Switch the working repo to one of the user's projects, picked from a list. Use when the user runs /repo, or asks to "switch to", "work in", "open", "cd into" or "set the root to" one of their projects${examples:+ ($examples, ...)}, or asks which projects they have.
argument-hint: "[project name or partial]"
---

# Switch to one of the user's projects

The \`prj\` command knows the user's projects (configured in \`$(tilde "$CONFIG")\`).$([ "$NAME" != prj ] && printf ' Always call it as `prj`:\nthe user'"'"'s own shortcut, `%s`, is a shell function that non-interactive shells don'"'"'t load.' "$NAME")

1. **List**: \`prj -l --tsv\` prints name, branch, last commit date and path, pinned and most used first.
   \`(windows worktree)\` or \`(unreachable)\` in the branch column means git can't open that repo from here.
   Don't try to repair it; that can break it for the OS that created it.
2. **Choose**: with a name in the request, resolve it with \`prj -p "<query>"\`. One path printed means a match;
   otherwise it lists the candidates. With no name, show a short numbered list (name, branch, last commit) and ask.
   If you use AskUserQuestion, offer the top 4 and let the user type any other name.
3. **Switch**: \`cd "<path>"\` (the shell's cwd persists), check \`git status -sb\` and \`git log --oneline -5\`,
   then read the project's \`CLAUDE.md\`/\`AGENTS.md\` if present, since they weren't loaded at startup.
4. **Mention once**: a mid-session switch doesn't load that project's \`.claude/settings.json\`, hooks, MCP servers or
   project memory. For a full switch, the user can exit and run \`$NAME <project>\`. Inside herdr or tmux,
   \`prj <project> -o auto\` opens it in a new tab with Claude running in it; you can run that if they ask.

$SKILL_MARKER
EOF
}

setup() {
  local existing=0 cands opts sel r chosen=() taken p
  load_config && existing=1
  printf 'prj setup%s\n\n' "$([ $existing = 1 ] && printf ' (editing %s)' "$(tilde "$CONFIG")")"

  # Roots
  if [ -n "$S_ROOTS" ]; then
    split_list ROOTS "$S_ROOTS"
  elif [ -z "$YES" ] || [ ${#ROOTS[@]} -eq 0 ]; then
    printf 'Looking for folders with git repos...\n'
    cands="$(candidate_roots)"
    opts=() sel=""
    while IFS="$TAB" read -r n p; do
      [ -n "$p" ] || continue
      opts+=("$(tilde "$p")  ($n repos)")
      if [ $existing = 1 ]; then
        for r in "${ROOTS[@]}"; do [ "$(expand "$r")" = "$p" ] && sel="$sel,${opts[${#opts[@]} - 1]}"; done
      elif [ "$n" -ge 2 ]; then sel="$sel,${opts[${#opts[@]} - 1]}"; fi
    done <<<"$cands"
    for r in "${ROOTS[@]}"; do   # keep configured roots that weren't auto-detected
      [ -n "$(printf '%s\n' "$cands" | awk -F'\t' -v p="$(expand "$r")" '$2 == p')" ] && continue
      opts+=("$(tilde "$(expand "$r")")  (configured)"); sel="$sel,${opts[${#opts[@]} - 1]}"
    done
    if [ -n "$YES" ]; then
      chosen=()
      while IFS= read -r r; do [ -n "$r" ] && chosen+=("$r"); done <<<"$(printf '%s\n' "${sel#,}" | tr ',' '\n')"
    elif [ ${#opts[@]} -gt 0 ]; then
      chosen=()
      while IFS= read -r r; do [ -n "$r" ] && chosen+=("$r"); done <<<"$(ask_multi 'Which folders hold your projects?' "${sel#,}" "${opts[@]}")"
    fi
    ROOTS=()
    for r in "${chosen[@]}"; do ROOTS+=("$(expand "${r%  (*}")"); done
    if [ -z "$YES" ]; then
      while p="$(ask_input 'Add another folder (blank when done)' '')" && [ -n "$p" ]; do
        p="$(expand "$p")"
        if [ -d "$p" ]; then ROOTS+=("$p"); else warn "$p is not a folder"; fi
      done
    fi
  fi
  [ ${#ROOTS[@]} -gt 0 ] || die "no project folders chosen; run prj --setup again, or pass --roots <dir>"

  # What to run, and where
  if [ -n "$S_RUN_SET" ]; then RUN="$S_RUN"
  elif [ -z "$YES" ]; then
    opts=(); while IFS= read -r r; do opts+=("$r"); done <<<"$(run_options)"
    if [ $existing = 1 ]; then opts=("${RUN:-(nothing, just a shell)} (current)" "${opts[@]}"); fi
    RUN="$(ask_choose 'What should open in a project?' "${opts[@]}")"
    RUN="${RUN% (current)}"
  elif [ $existing = 0 ]; then RUN="$(run_options)" RUN="${RUN%%
*}"; fi
  [ "$RUN" = '(nothing, just a shell)' ] && RUN=""

  if [ -n "$S_OPEN" ]; then OPEN="$S_OPEN"
  elif [ -z "$YES" ]; then
    OPEN="$(ask_choose 'Where should it open?' \
      'auto: new herdr/tmux tab if inside one, else here' \
      'here: always this terminal' 'herdr-tab' 'tmux-window')"
    OPEN="${OPEN%%:*}"
  fi

  # Command names
  [ -n "$S_NAME" ] && NAME="$S_NAME"
  [ -n "$S_CD_NAME_SET" ] && CD_NAME="$S_CD_NAME"
  if [ -z "$YES" ]; then
    while :; do
      NAME="$(ask_input 'Command you type to open a project' "$NAME")"
      valid_name "$NAME" || { warn "letters, digits, - and _ only"; continue; }
      [ "$NAME" = prj ] && break
      taken="$(name_taken "$NAME")" || break
      ask_yn "'$NAME' already exists ($taken). Use it anyway?" && break
    done
    while :; do
      CD_NAME="$(ask_input 'Command that just cd'"'"'s into a project (blank for none)' "$CD_NAME")"
      [ -z "$CD_NAME" ] && break
      valid_name "$CD_NAME" || { warn "letters, digits, - and _ only"; continue; }
      taken="$(name_taken "$CD_NAME")" || break
      ask_yn "'$CD_NAME' already exists ($taken). Use it anyway?" && break
    done
  fi
  valid_name "$NAME" || die "invalid command name '$NAME'"
  [ -z "$CD_NAME" ] || valid_name "$CD_NAME" || die "invalid cd command name '$CD_NAME'"

  write_config
  printf '\nSaved %s\n' "$(tilde "$CONFIG")"

  # Make sure `prj` itself is on PATH
  if ! have prj; then
    mkdir -p "$HOME/.local/bin" && cp "$0" "$HOME/.local/bin/prj" && chmod +x "$HOME/.local/bin/prj"
    printf 'Installed prj to ~/.local/bin%s\n' "$(case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) printf ' (add it to your PATH)' ;; esac)"
  fi

  if [ -n "$S_NO_SHELL" ]; then :
  elif [ -n "$YES" ] || ask_yn "Set up '$NAME'${CD_NAME:+ and '$CD_NAME'} plus tab completion in your shell?"; then
    write_shell_integration
    printf 'Shell integration: %s (open a new terminal, or: source ~/.%src)\n' "$(tilde "$CONFIG_DIR/shell.sh")" "${SHELL##*/}"
  fi

  if [ -d "$HOME/.claude" ] && [ -z "$S_NO_SKILL" ]; then
    if [ -n "$YES" ] || ask_yn "Install a /repo skill so Claude Code can switch projects for you?"; then
      write_claude_skill && printf 'Claude skill: ~/.claude/skills/repo/SKILL.md\n'
    fi
  fi

  printf '\nDone. %s projects found. Try: %s\n' "$(discover | grep -c .)" "$NAME"
}

# ---------------------------------------------------------------- uninstall

# Remove what setup added outside the config: shell hooks, shell files and the Claude skill.
uninstall() {
  local rc hook f skill="$HOME/.claude/skills/repo/SKILL.md"
  hook="$(rc_hook)"
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    [ -f "$rc" ] && grep -qxF "$hook" "$rc" || continue
    grep -vxF -e "$hook" -e "$RC_COMMENT" "$rc" >"$rc.prj-tmp" && cat "$rc.prj-tmp" >"$rc" && rm -f "$rc.prj-tmp"
    printf 'removed the hook from %s\n' "$(tilde "$rc")"
  done
  for f in "$CONFIG_DIR/shell.sh" "$HOME/.config/fish/conf.d/prj.fish"; do
    [ -f "$f" ] && rm -f "$f" && printf 'removed %s\n' "$(tilde "$f")"
  done
  if [ -f "$skill" ] && grep -qF "$SKILL_MARKER" "$skill"; then
    rm -f "$skill" && rmdir "${skill%/*}" 2>/dev/null
    printf 'removed %s\n' "$(tilde "$skill")"
  fi
  printf 'Kept your settings and history: %s, %s\n' "$(tilde "$CONFIG")" "$(tilde "$STATE_DIR")"
  printf 'To finish, delete the prj script: %s\n' "$(tilde "$(command -v prj 2>/dev/null || printf '%s' "$0")")"
}

# ---------------------------------------------------------------- doctor

doctor() {
  local ok='\033[32mok\033[0m' no='\033[31m!!\033[0m' opt='\033[33m--\033[0m' c r n rc first
  check() { printf " $1  %s\n" "$2"; }
  printf 'prj %s\n\nDependencies\n' "$PRJ_VERSION"
  for c in git fzf; do have "$c" && check "$ok" "$c" || check "$no" "$c (required)"; done
  for c in gum jq herdr tmux; do have "$c" && check "$ok" "$c" || check "$opt" "$c (optional)"; done

  printf '\nConfig\n'
  if ! load_config; then check "$no" "no config at $(tilde "$CONFIG"): run prj --setup"; return 1; fi
  check "$ok" "$(tilde "$CONFIG")"
  for r in "${ROOTS[@]}"; do
    if [ -d "$(expand "$r")" ]; then n="$(ROOTS=("$r"); discover | grep -c .)"; check "$ok" "$r ($n repos)"
    else check "$no" "$r not found (unmounted drive?)"; fi
  done
  first="${RUN%% *}"
  if [ -z "$RUN" ]; then check "$ok" "run: nothing (opens a shell)"
  elif have "$first"; then check "$ok" "run: $RUN"
  else check "$opt" "run: $RUN ('$first' isn't a program; fine if it's a shell alias or function)"; fi
  check "$ok" "open: $OPEN"

  printf '\nShell\n'
  if [ -f "$CONFIG_DIR/shell.sh" ]; then check "$ok" "$(tilde "$CONFIG_DIR/shell.sh") defines: $NAME${CD_NAME:+, $CD_NAME}"
  else check "$opt" "no shell integration (prj --setup adds it)"; fi
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    [ -f "$rc" ] || continue
    grep -qxF "$(rc_hook)" "$rc" && check "$ok" "$(tilde "$rc") loads it" || check "$opt" "$(tilde "$rc") doesn't load it"
  done
  have prj && check "$ok" "prj on PATH: $(tilde "$(command -v prj)")" || check "$no" "prj isn't on PATH"

  printf '\nClaude Code\n'
  [ -f "$HOME/.claude/skills/repo/SKILL.md" ] && check "$ok" "/repo skill installed" || check "$opt" "/repo skill not installed"
}

# ---------------------------------------------------------------- main

MODE=open QUERY="" TSV="" YES="" AGENT_ARGS=()
S_ROOTS="" S_RUN="" S_RUN_SET="" S_OPEN="" S_NAME="" S_CD_NAME="" S_CD_NAME_SET="" S_NO_SHELL="" S_NO_SKILL=""
while [ $# -gt 0 ]; do
  case "$1" in
    -l | --list) MODE=list ;;
    --tsv) TSV=1 ;;
    --names) MODE=names ;;
    -p | --path) MODE=path ;;
    -o | --open) S_OPEN="$2"; shift ;;
    -r | --run) S_RUN="$2" S_RUN_SET=1; shift ;;
    --setup) MODE=setup ;;
    --doctor) MODE=doctor ;;
    --edit) MODE=edit ;;
    --uninstall) MODE=uninstall ;;
    -y | --yes) YES=1 ;;
    --roots) S_ROOTS="$2"; shift ;;
    --name) S_NAME="$2"; shift ;;
    --cd-name) S_CD_NAME="$2" S_CD_NAME_SET=1; shift ;;
    --no-shell) S_NO_SHELL=1 ;;
    --no-skill) S_NO_SKILL=1 ;;
    -h | --help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -V | --version) printf 'prj %s\n' "$PRJ_VERSION"; exit 0 ;;
    --) shift; AGENT_ARGS=("$@"); break ;;
    -*) die "unknown option $1 (see prj --help)" ;;
    *) QUERY="$1" ;;
  esac
  shift
done

case "$MODE" in
  setup) setup; exit ;;
  doctor) doctor; exit ;;
  uninstall) load_config; uninstall; exit ;;
  edit) [ -f "$CONFIG" ] || die "no config yet: run prj --setup"; exec "${EDITOR:-vi}" "$CONFIG" ;;
esac

if ! load_config; then
  [ "$MODE" = names ] && exit 0
  has_tty || die "not set up yet: run prj --setup"
  setup || exit 1
  load_config
fi
have fzf || die "fzf is required (install it with your package manager)"
[ "$S_RUN_SET" ] && RUN="$S_RUN"
[ -n "$S_OPEN" ] && OPEN="$S_OPEN"

case "$MODE" in
  names) discover | sed 's#.*/##' ;;
  list)
    [ -n "$(discover)" ] || no_projects
    if [ -n "$TSV" ]; then list_rows | awk -F'\t' -v OFS='\t' '{ print $4, $5, $3, $6, ($1 < 999) ? "pinned" : "" }'
    else list_rows | format_rows | awk -F'\t' '{ printf "%s  %s\n", $1, $2 }'; fi
    ;;
  path) dir="$(pick "$QUERY")" && [ -n "$dir" ] && record "$dir" && printf '%s\n' "$dir" ;;
  open) dir="$(pick "$QUERY")" && [ -n "$dir" ] || exit 130; open_project "$dir" ;;
esac
